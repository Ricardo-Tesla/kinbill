{
  "name": "kinbill",
  "version": "0.1.0",
  "description": "Kin-bill: a voice-first PayPal payment assistant where risky payments wait for a trusted family member's approval.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "check:paypal": "node --env-file-if-exists=.env scripts/check-paypal.js",
    "spike": "node --env-file-if-exists=.env scripts/spike-paypal.js",
    "spike:vault": "node --env-file-if-exists=.env scripts/spike-vault.js",
    "try:rules": "node scripts/try-rules.js",
    "try:ai": "node --env-file-if-exists=.env scripts/try-ai.js"
  },
  "dependencies": {
    "ag-grid-community": "^36.2.0",
    "express": "^4.21.2"
  }
}
