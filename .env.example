# Copy this file to ".env" and fill in your own SANDBOX values.
# Never commit .env — it is in .gitignore.

# Server
PORT=3000

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Sandbox test accounts (developer.paypal.com > Testing Tools > Sandbox Accounts)
# Joe the plumber: a second BUSINESS account that receives Grace's payments
PAYEE_JOE_EMAIL=

# AI scam checker. AI_PROVIDER = gemini | claude | keywords (no AI, built-in backup)
AI_PROVIDER=gemini
# Free key: aistudio.google.com > Get API key
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-flash-latest
# Optional: GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest  (used when the main model is busy)
# Optional, if you use Claude instead:
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5

# PIN David enters on his helper screen (/david.html). Change it.
HELPER_PIN=2468

# How long a held payment waits for David before the safety timer cancels it.
# 172800 = 48 hours. Use 120 (2 minutes) for the demo video.
HOLD_TIMEOUT_SECONDS=172800
# How often the safety timer checks (seconds)
SWEEP_INTERVAL_SECONDS=30

# PayPal webhooks (only once Kin-bill is online at a public URL, feature 10):
# developer.paypal.com > Apps & Credentials > your app > Add Webhook
#   URL: https://YOUR-APP/api/paypal/webhook
#   Events: Payment payouts-item succeeded/failed/returned/blocked/denied,
#           Payment authorization voided, Payment capture completed
PAYPAL_WEBHOOK_ID=

# Database file (created automatically)
DB_PATH=kinbill.db

# Where the app is reachable (PayPal returns Grace here after connecting). Default: http://localhost:3000
# PUBLIC_URL=
